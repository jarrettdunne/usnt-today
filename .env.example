# Copy this file to .env and fill in both values.
# Then run: npm run env:sync  (copies them into each app's .dev.vars)

# Neon connection string: Neon dashboard > your project > Connect
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Free API token: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=""
