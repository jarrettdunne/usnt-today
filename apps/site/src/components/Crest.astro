---
// A team's crest, sized up front so the line doesn't shift as it loads. The team
// name is always written next to it, so the image is decorative (alt=""). A team
// without a crest gets an empty box of the same size, keeping names aligned.
import { safeHref } from '@usnt/db';

interface Props {
  url: string | null;
}

const src = safeHref(Astro.props.url);
---

{
  src ? (
    <img class="crest" src={src} alt="" width="18" height="18" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
  ) : (
    <span class="crest" aria-hidden="true" />
  )
}
